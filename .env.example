# Aurelius Microsoft Agent Framework - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# AZURE CREDENTIALS
# ============================================================================

# Azure Tenant Configuration
AZURE_TENANT_ID=944b3898-fcbe-4631-91e1-794e102c9c7d
AZURE_CLIENT_ID=8cdaa6eb-c294-444c-940a-239a47fc98a8
AZURE_CLIENT_SECRET=  # Fill in from aurelius_credentials.json

# Organization Details
AZURE_ENVIRONMENT_URL=https://org090d0208.crm.dynamics.com/
AZURE_ORGANIZATION_ID=88502127-ab55-4ef6-ab86-b533f1c168eb

# ============================================================================
# AZURE OPENAI SERVICE
# ============================================================================

# Azure OpenAI Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=  # Use Azure CLI auth in dev, Key Vault in prod
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Deployment Names
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME=gpt-4o-responses
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT_NAME=text-embedding-ada-002

# ============================================================================
# AZURE AI FOUNDRY
# ============================================================================

AZURE_AI_PROJECT_ENDPOINT=https://<your-project>.azureai.azure.com
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o
AZURE_AI_API_KEY=  # Optional if using managed identity

# ============================================================================
# OPENAI (NON-AZURE)
# ============================================================================

OPENAI_API_KEY=  # sk-...
OPENAI_CHAT_MODEL_ID=gpt-4o
OPENAI_ORGANIZATION_ID=  # Optional

# ============================================================================
# ANTHROPIC CLAUDE
# ============================================================================

ANTHROPIC_API_KEY=  # sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# OLLAMA (LOCAL MODELS)
# ============================================================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ============================================================================
# AZURE KEY VAULT
# ============================================================================

AZURE_KEY_VAULT_URL=https://aurelius-kv.vault.azure.net/
# Use managed identity in Azure, Azure CLI in local dev
# No key needed when using managed identity

# ============================================================================
# STATE MANAGEMENT
# ============================================================================

# Redis (Azure Cache for Redis)
REDIS_HOST=aurelius-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=  # Retrieve from Key Vault
REDIS_SSL=true
REDIS_DB=0

# ============================================================================
# CONTEXT PROVIDERS
# ============================================================================

# Mem0 Configuration
MEM0_API_KEY=  # Optional if self-hosting
MEM0_API_URL=https://api.mem0.ai

# ============================================================================
# OBSERVABILITY
# ============================================================================

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.azure.com
OTEL_EXPORTER_OTLP_HEADERS=  # Authentication headers
OTEL_SERVICE_NAME=aurelius-agent-framework
OTEL_RESOURCE_ATTRIBUTES=service.namespace=aurelius,deployment.environment=dev

# Azure Monitor (Application Insights)
APPLICATIONINSIGHTS_CONNECTION_STRING=  # From Azure Portal

# ============================================================================
# SECURITY & COMPLIANCE
# ============================================================================

# Classification
DATA_CLASSIFICATION=CUI  # Options: PUBLIC, CUI, FOUO, CONFIDENTIAL
DEPLOYMENT_ENVIRONMENT=development  # Options: development, staging, production, federal

# Session Configuration
SESSION_TIMEOUT_MINUTES=15
MFA_REQUIRED=true

# Encryption
ENCRYPTION_KEY_ID=  # Azure Key Vault key identifier for data encryption

# ============================================================================
# GITHUB INTEGRATION
# ============================================================================

GITHUB_APP_ID=1671426
GITHUB_CLIENT_ID=Iv23liJA8BxI8C62eDkc
GITHUB_PRIVATE_KEY=  # Path to private key file
GITHUB_WEBHOOK_SECRET=  # Webhook secret

# ============================================================================
# POWER PLATFORM
# ============================================================================

POWER_PLATFORM_ENVIRONMENT=Default-944b3898-fcbe-4631-91e1-794e102c9c7d
POWER_PLATFORM_API_URL=https://org090d0208.crm.dynamics.com/api/data/v9.2

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_DEVUI=true
ENABLE_WORKFLOWS=true
ENABLE_MCP=true
ENABLE_A2A=true
ENABLE_TELEMETRY=true

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

DEBUG=false
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, text

# Testing
PYTEST_CACHE_DIR=.pytest_cache
COVERAGE_FILE=.coverage

# ============================================================================
# FEDERAL COMPLIANCE
# ============================================================================

# CMMC Configuration
CMMC_LEVEL=2
NIST_800_171_COMPLIANCE=true
FEDRAMP_LEVEL=moderate

# Audit Logging
AUDIT_LOG_RETENTION_DAYS=3650  # 10 years for federal
AUDIT_LOG_DESTINATION=azure-cosmos-db

# CUI Handling
CUI_MARKING_ENABLED=true
CUI_BANNER_TEXT="CONTROLLED UNCLASSIFIED INFORMATION"
CUI_FOOTER_TEXT="DISTRIBUTION AUTHORIZED TO DOD AND DOD CONTRACTORS ONLY"

# ============================================================================
# RATE LIMITING
# ============================================================================

RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_BURST_SIZE=10

# ============================================================================
# SMTP (FOR NOTIFICATIONS)
# ============================================================================

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notifications@aureliustech.com
SMTP_PASSWORD=  # Retrieve from Key Vault
SMTP_FROM_EMAIL=noreply@aureliustech.com

# ============================================================================
# MONITORING & ALERTING
# ============================================================================

# PagerDuty
PAGERDUTY_INTEGRATION_KEY=  # For critical alerts

# Slack
SLACK_WEBHOOK_URL=  # For warning alerts
SLACK_CHANNEL=#alerts

# ============================================================================
# NOTES
# ============================================================================

# 1. Store secrets in Azure Key Vault, not in .env (production)
# 2. Use managed identities when running in Azure
# 3. Rotate secrets every 90 days per NIST 800-171
# 4. Monitor secret access in Azure Monitor
# 5. Never commit .env file to git (listed in .gitignore)
