# MLTE Integration Environment Variables
# Copy this file to .env and customize for your environment
#
# Federal Compliance: CMMC L2, NIST 800-171, NIST AI RMF
# Organization: Aurelius Tech & Talent Solutions
#
# IMPORTANT: Never commit .env files with real credentials to git!

# ============================================================================
# MLTE Store Configuration
# ============================================================================

# Store URI - Choose based on environment:
#   - Development: fs://./mlte-store
#   - Production: postgresql://user:pass@host:5432/mlte
#   - Testing: memory://
#   - Remote: http://mlte-backend:8080
MLTE_STORE_URI=fs://./mlte-store

# Store type (filesystem, postgresql, memory, http)
MLTE_STORE_TYPE=filesystem

# ============================================================================
# Evaluation Settings
# ============================================================================

# Enable/disable MLTE evaluation
MLTE_ENABLE_EVALUATION=true

# Evaluation mode: synchronous, asynchronous, ci_only
MLTE_EVALUATION_MODE=synchronous

# Fail build on evaluation errors (true/false)
MLTE_FAIL_ON_ERROR=false

# ============================================================================
# Quality Gate Thresholds
# ============================================================================

# Minimum accuracy threshold (0.0-1.0)
MLTE_QUALITY_GATE_ACCURACY_MIN=0.95

# Minimum security threshold (0.0-1.0)
MLTE_QUALITY_GATE_SECURITY_MIN=0.90

# Maximum latency threshold (milliseconds)
MLTE_QUALITY_GATE_LATENCY_MAX_MS=2000

# Maximum memory usage (MB)
MLTE_QUALITY_GATE_MEMORY_MAX_MB=512

# ============================================================================
# Orchestrator Configuration
# ============================================================================

# Enable parallel evaluation
MLTE_ORCHESTRATOR_PARALLEL=true

# Maximum parallel workers
MLTE_ORCHESTRATOR_MAX_WORKERS=4

# Evaluation timeout (seconds)
MLTE_ORCHESTRATOR_TIMEOUT=300

# ============================================================================
# LLM Configuration
# ============================================================================

# LLM Provider: openai, azure_openai, local
MLTE_LLM_PROVIDER=openai

# Default LLM model for all agents
MLTE_LLM_MODEL=gpt-4

# LLM API endpoint (for Azure OpenAI)
# MLTE_LLM_ENDPOINT=https://your-resource.openai.azure.com/

# LLM API key (for OpenAI or Azure OpenAI)
# MLTE_LLM_API_KEY=your-api-key-here

# LLM API version (for Azure OpenAI)
# MLTE_LLM_API_VERSION=2024-02-15-preview

# Per-agent model overrides (optional)
# MLTE_LLM_NEGOTIATION_MODEL=gpt-4
# MLTE_LLM_TESTING_MODEL=gpt-4
# MLTE_LLM_VALIDATION_MODEL=gpt-4
# MLTE_LLM_REPORTING_MODEL=gpt-4
# MLTE_LLM_COMPLIANCE_MODEL=gpt-4

# ============================================================================
# Federal Compliance Configuration
# ============================================================================

# Enable federal compliance agent
ENABLE_FEDERAL_COMPLIANCE_AGENT=true

# Compliance standards (comma-separated)
MLTE_FEDERAL_STANDARDS="NIST AI RMF,CMMC L2,NIST 800-171"

# Enable OSCAL export
MLTE_OSCAL_EXPORT=true

# Enable detailed audit trail
MLTE_AUDIT_TRAIL=true

# Data classification level (CUI, Public, Confidential)
MLTE_CLASSIFICATION=CUI

# ============================================================================
# PostgreSQL Configuration (for production)
# ============================================================================

# PostgreSQL connection details
# MLTE_POSTGRES_HOST=localhost
# MLTE_POSTGRES_PORT=5432
# MLTE_POSTGRES_DB=mlte
# MLTE_POSTGRES_USER=mlte_user
# MLTE_POSTGRES_PASSWORD=your-secure-password-here
# MLTE_POSTGRES_SSLMODE=require

# Connection pool settings
# MLTE_POSTGRES_POOL_SIZE=10
# MLTE_POSTGRES_MAX_OVERFLOW=20

# ============================================================================
# Azure Configuration (for production)
# ============================================================================

# Azure Key Vault for secrets management
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/

# Azure Blob Storage for MLTE catalog
# AZURE_STORAGE_ACCOUNT=your-storage-account
# AZURE_STORAGE_CONTAINER=mlte-catalog
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
MLTE_LOG_LEVEL=INFO

# Log format (json, text)
MLTE_LOG_FORMAT=json

# Log to file
# MLTE_LOG_FILE=./logs/mlte.log

# ============================================================================
# CI/CD Configuration
# ============================================================================

# CI/CD mode indicators (set by CI systems)
# CI=true
# GITHUB_ACTIONS=true
# GITHUB_RUN_ID=12345
# GITHUB_SHA=abcdef123456

# ============================================================================
# Development / Testing
# ============================================================================

# Enable debug mode
# MLTE_DEBUG=false

# Skip expensive tests in development
# MLTE_SKIP_SLOW_TESTS=false

# Use mock LLM for testing
# MLTE_USE_MOCK_LLM=false

# ============================================================================
# Security Notes
# ============================================================================
#
# Federal Compliance Requirements:
# - Never commit API keys or passwords to version control
# - Use Azure Key Vault or similar for production secrets
# - Enable audit_trail for CMMC L2 compliance
# - Use TLS/SSL for all database connections in production
# - Set appropriate classification level for all data
#
# Best Practices:
# - Rotate API keys regularly
# - Use separate credentials for dev/staging/prod
# - Limit API key permissions to minimum required
# - Monitor API usage and set alerts for anomalies
# - Use environment-specific .env files
#
# CMMC L2 Controls:
# - AC.L2-3.1.1: Access control
# - IA.L2-3.5.1: Identification and authentication
# - SC.L2-3.13.1: Boundary protection
# - SC.L2-3.13.8: Transmission confidentiality
#
# ============================================================================
