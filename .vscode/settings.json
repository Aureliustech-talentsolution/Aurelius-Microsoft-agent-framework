{
  // This is the root workspace settings file
  // It provides defaults for the entire repository

  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml",
    ".env.example": "dotenv",
    "*.toml": "toml",
    ".aurelius/**/*.md": "markdown"
  },

  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/artifacts": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/htmlcov": true,
    "**/.aurelius/evidence": true
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  },

  "python.defaultInterpreterPath": "${workspaceFolder}/python/.venv/bin/python",
  "python.analysis.typeCheckingMode": "strict",

  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },

  "git.openRepositoryInParentFolders": "always"
}
